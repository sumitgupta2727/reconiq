# ---------------------------------------------------------------------------
# ReconIQ environment variables (backend + docker-compose)
#
# Copy this file to `.env` and adjust the values.
#
# NOTE: Spring Boot does not read `.env` automatically. Either export these
# variables in your shell, use the provided docker-compose file, or start the
# backend from an IDE after adding them to the run configuration.
# ---------------------------------------------------------------------------

# --- MySQL ---------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/reconiq_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=reconiq
DB_PASSWORD=change-me

# Used only by docker-compose to initialise the container.
DB_ROOT_PASSWORD=change-root-password

# --- Server --------------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE=10MB

# --- Demo data -----------------------------------------------------------
# Set SEED_ENABLED=false in production.
SEED_ENABLED=true
SEED_DEMO_DATA=true
SEED_ADMIN_EMPLOYEE_ID=ADMIN001
SEED_ADMIN_NAME=ReconIQ Admin
SEED_ADMIN_EMAIL=admin@reconiq.local
SEED_ADMIN_PASSWORD=admin123

# --- Report email --------------------------------------------------------
# PDF reports are emailed from the Reports page. Create a Gmail app password
# (https://myaccount.google.com/apppasswords) and fill in MAIL_USER/MAIL_PASS.
REPORT_EMAIL_ENABLED=true
REPORT_EMAIL_TO=
MAIL_USER=
MAIL_PASS=
# Optional SMTP override (defaults work for Gmail):
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
